# LLM dung cho agent va LLM judge. Doi provider thi doi ca LLM_MODEL va key tuong ung.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Embedding chay local theo yeu cau cua bai lab: MiniLM, vector 384 chieu, khong can API key.
# Dat EMBEDDING_PROVIDER=openai neu muon dung embedding cua OpenAI thay the.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Bat lop metric Ragas (cham hon, co goi LLM). De trong hoac 0 de bo qua.
RUN_RAGAS=1
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
